# Minimal bootstrap variables (required before DB/cache connect)
# All other configuration is in Admin > Auth Config

# Docker dev: absolute path to project root (required if using worktrees or running from different dir)
# PROJECT_ROOT=/full/path/to/tableau-ai-demo-main

# DB/Redis: localhost or host.docker.internal both work. Config auto-resolves:
#   - In Docker: localhost → host.docker.internal
#   - On host (alembic, pytest, uvicorn): host.docker.internal → localhost
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tableau_demo
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=your-secret-key-change-in-production
AUTH0_SECRET=your-auth0-cookie-secret-32-chars-min
