{
  "setup-worktree-unix": [
    "ln -sf \"${PROJECT_ROOT:-$(cd .. && pwd)}/shared/.env\" .env",
    "ln -sf \"${PROJECT_ROOT:-$(cd .. && pwd)}/shared/localhost-key.pem\" frontend/localhost-key.pem",
    "ln -sf \"${PROJECT_ROOT:-$(cd .. && pwd)}/shared/localhost.pem\" frontend/localhost.pem"
  ],
  "setup-worktree-windows": [
    "copy \"%PROJECT_ROOT%\\shared\\.env\" .env",
    "mklink frontend\\localhost-key.pem \"%PROJECT_ROOT%\\shared\\localhost-key.pem\"",
    "mklink frontend\\localhost.pem \"%PROJECT_ROOT%\\shared\\localhost.pem\""
  ],
  "setup-worktree": [
    "ln -sf \"${PROJECT_ROOT:-$(cd .. && pwd)}/shared/.env\" .env",
    "ln -sf \"${PROJECT_ROOT:-$(cd .. && pwd)}/shared/localhost-key.pem\" frontend/localhost-key.pem",
    "ln -sf \"${PROJECT_ROOT:-$(cd .. && pwd)}/shared/localhost.pem\" frontend/localhost.pem"
  ]
}
